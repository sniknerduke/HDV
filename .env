# Copy this file to .env and fill in your values

# Backend service URLs (optional - defaults to localhost:9090)
# VITE_COURSE_SERVICE_URL=http://localhost:9090
# VITE_LESSON_SERVICE_URL=http://localhost:9090

# YouTube Data API v3 key for playlist import feature
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud Console
VITE_YOUTUBE_API_KEY=f
