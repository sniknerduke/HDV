        <mxCell id="eYesToken" value="Yes" edge="1" parent="groupLeft" source="decHasToken" target="attachToken"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="300"/></Array></mxGeometry></mxCell>

        <mxCell id="eRes1" edge="1" parent="groupLeft" source="handleRes" target="decStatus"><mxGeometry relative="1" as="geometry"/></mxCell>
