        <mxCell id="eRes3" value="Error" edge="1" parent="groupLeft" source="decStatus" target="showErr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="810"/></Array></mxGeometry></mxCell>
        
