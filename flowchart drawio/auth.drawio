        </mxCell>

        <mxCell id="checkRole" value="Check Role (@PreAuthorize)&#10;Admin/Staff/User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="groupRight">
