        <mxCell id="eRoleYes" value="Yes" edge="1" parent="groupRight" source="decRole" target="controller"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="600"/><mxPoint x="180" y="600"/></Array></mxGeometry></mxCell>

