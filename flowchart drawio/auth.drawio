        <mxCell id="e1" edge="1" parent="groupLeft" source="start" target="userReq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="groupLeft" source="userReq" target="checkToken"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="groupLeft" source="checkToken" target="decHasToken"><mxGeometry relative="1" as="geometry"/></mxCell>
        
