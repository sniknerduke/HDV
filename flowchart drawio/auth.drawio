        <mxCell id="eVal" value="Yes" edge="1" parent="groupRight" source="decValid" target="decAuth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="320"/></Array></mxGeometry></mxCell>

        <mxCell id="eProt" value="Protected" edge="1" parent="groupRight" source="decAuth" target="checkRole"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="420"/></Array></mxGeometry></mxCell>
        <mxCell id="ePub" value="Public" edge="1" parent="groupRight" source="decAuth" target="controller"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="370"/><mxPoint x="340" y="600"/><mxPoint x="180" y="600"/></Array></mxGeometry></mxCell>

        <mxCell id="eRoleCheck" edge="1" parent="groupRight" source="checkRole" target="decRole"><mxGeometry relative="1" as="geometry"/></mxCell>
        
