        <mxCell id="openScreen" value="Mở màn hình&#10;Thống kê Doanh thu" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="groupLeft">
