        <mxCell id="showEmpty" value="Hiện: &quot;Không có&#10;dữ liệu&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="groupLeft">
