<mxfile host="app.diagrams.net">
  <diagram name="Chatbot Flow Vertical" id="chatbot-flow-vertical">
    <mxGraphModel dx="1290" dy="756" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="groupLeft" value="" style="group;rounded=1;dashed=1;strokeColor=#b0b0b0;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="40" y="40" width="360" height="980" as="geometry" />
        </mxCell>
        <mxCell id="bgLeft" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=none;" vertex="1" parent="groupLeft">
          <mxGeometry width="360" height="980" as="geometry" />
        </mxCell>

        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="groupLeft">
          <mxGeometry x="150" y="30" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="openChat" value="User Mở Chat Widget" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="groupLeft">
          <mxGeometry x="80" y="110" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="botGreet" value="Bot: Chào &amp; Gợi ý" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="groupLeft">
          <mxGeometry x="80" y="180" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="userMsg" value="User: Nhập câu hỏi&#10;(Khóa học, Lỗi, Account...)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="groupLeft">
          <mxGeometry x="60" y="250" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="botReply" value="Bot: Trả lời User&#10;(Text / Link / Button)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="groupLeft">
          <mxGeometry x="60" y="650" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="decResolved" value="Hài lòng /&#10;Giải quyết xong?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="groupLeft">
          <mxGeometry x="110" y="740" width="140" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="thankYou" value="Bot: Cảm ơn User" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="groupLeft">
          <mxGeometry x="20" y="840" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="waitTicket" value="Bot: Đã tạo Ticket&#10;hỗ trợ kỹ thuật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="groupLeft">
          <mxGeometry x="200" y="840" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="decCont" value="Tiếp tục?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="groupLeft">
          <mxGeometry x="120" y="900" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;" vertex="1" parent="groupLeft">
          <mxGeometry x="280" y="910" width="50" height="50" as="geometry" />
        </mxCell>


        <mxCell id="groupRight" value="" style="group;rounded=1;dashed=1;strokeColor=#b0b0b0;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="420" y="40" width="360" height="980" as="geometry" />
        </mxCell>
        <mxCell id="bgRight" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=none;" vertex="1" parent="groupRight">
          <mxGeometry width="360" height="980" as="geometry" />
        </mxCell>

        <mxCell id="nlpProcess" value="AI: Detect Intent &amp; Context&#10;(User Role, Page, History)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="groupRight">
          <mxGeometry x="60" y="255" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="decIntent" value="Intent Type?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="groupRight">
          <mxGeometry x="120" y="330" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="logicCourse" value="API: Tra cứu Khóa học&#10;(Gợi ý, Lộ trình)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="groupRight">
          <mxGeometry x="20" y="420" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="logicPay" value="API: Check Thanh toán&#10;(VNPay Status)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="groupRight">
          <mxGeometry x="200" y="420" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="logicSupport" value="Knowledge Base:&#10;Hướng dẫn Tech/Auth" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="groupRight">
          <mxGeometry x="110" y="490" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="buildAns" value="AI: Xây dựng câu trả lời&#10;(Dựa trên Data &amp; Context)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="groupRight">
          <mxGeometry x="80" y="580" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="createTicket" value="Backend: Tạo Ticket&#10;(Chuyển NV Hỗ trợ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="groupRight">
          <mxGeometry x="80" y="750" width="200" height="50" as="geometry" />
        </mxCell>


        <mxCell id="e1" edge="1" parent="groupLeft" source="start" target="openChat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="groupLeft" source="openChat" target="botGreet"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="groupLeft" source="botGreet" target="userMsg"><mxGeometry relative="1" as="geometry"/></mxCell>
        
        <mxCell id="eRes1" edge="1" parent="groupLeft" source="botReply" target="decResolved"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eResYes" value="Yes" edge="1" parent="groupLeft" source="decResolved" target="thankYou"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="775"/></Array></mxGeometry></mxCell>
        <mxCell id="eResNo" value="No" edge="1" parent="groupLeft" source="decResolved" target="waitTicket"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="775"/></Array></mxGeometry></mxCell>

        <mxCell id="eCont1" edge="1" parent="groupLeft" source="thankYou" target="decCont"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eCont2" edge="1" parent="groupLeft" source="waitTicket" target="decCont"><mxGeometry relative="1" as="geometry"/></mxCell>
        
        <mxCell id="eLoop" value="Yes" edge="1" parent="groupLeft" source="decCont" target="userMsg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="930"/><mxPoint x="40" y="280"/></Array></mxGeometry></mxCell>
        <mxCell id="eEnd" value="No" edge="1" parent="groupLeft" source="decCont" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>


        <mxCell id="eToAI" value="Gửi tin nhắn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;entryX=0;entryY=0.5;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="userMsg" target="nlpProcess">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eR1" edge="1" parent="groupRight" source="nlpProcess" target="decIntent"><mxGeometry relative="1" as="geometry"/></mxCell>
        
        <mxCell id="eInt1" value="Course" edge="1" parent="groupRight" source="decIntent" target="logicCourse"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="360"/></Array></mxGeometry></mxCell>
        <mxCell id="eInt2" value="Payment" edge="1" parent="groupRight" source="decIntent" target="logicPay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="360"/></Array></mxGeometry></mxCell>
        <mxCell id="eInt3" value="Support" edge="1" parent="groupRight" source="decIntent" target="logicSupport"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eM1" edge="1" parent="groupRight" source="logicCourse" target="buildAns"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="560"/><mxPoint x="180" y="560"/></Array></mxGeometry></mxCell>
        <mxCell id="eM2" edge="1" parent="groupRight" source="logicPay" target="buildAns"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="560"/><mxPoint x="180" y="560"/></Array></mxGeometry></mxCell>
        <mxCell id="eM3" edge="1" parent="groupRight" source="logicSupport" target="buildAns"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eToUser" value="Phản hồi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;entryX=1;entryY=0.5;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" edge="1" parent="1" source="buildAns" target="botReply">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="720" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eToTicket" value="Tạo Ticket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;entryX=0;entryY=0.5;dashed=1;strokeWidth=2;" edge="1" parent="1" source="decResolved" target="createTicket">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="815" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="eTicketDone" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="createTicket" target="waitTicket">
          <mxGeometry relative="1" as="geometry">
