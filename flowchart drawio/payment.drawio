        <mxCell id="node3" value="3. Payment Service:&#10;Tạo Tx (PENDING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="group1">
