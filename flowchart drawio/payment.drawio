        <mxCell id="node7" value="7. User nhập thẻ &amp;&#10;Xác nhận (OTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="group1">
          <mxGeometry x="70" y="610" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="node8" value="8. VNPay xử lý giao dịch..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="group1">
          <mxGeometry x="70" y="680" width="200" height="50" as="geometry" />
